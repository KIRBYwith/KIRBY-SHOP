FROM python:3.10-slim

WORKDIR /app

# 시스템 패키지 설치
RUN apt-get update && apt-get install -y \
    gcc \
    default-libmysqlclient-dev \
    pkg-config \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Python 패키지 설치
COPY kirby-shop-backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# 애플리케이션 코드 복사
COPY kirby-shop-backend/ .

# uploads 디렉토리 생성
RUN mkdir -p uploads qna_images

# 포트 노출
EXPOSE 8000

# 의도적 취약점 1: 디버그 모드로 실행 (에러 메시지 노출)
# 의도적 취약점 2: root 권한으로 실행 (컨테이너 보안 위험)
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]

